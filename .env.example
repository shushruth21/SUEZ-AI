COMPOSE_PROJECT_NAME=suez

# Database (Compose)
POSTGRES_DB=suez
POSTGRES_USER=suez
POSTGRES_PASSWORD=suez
POSTGRES_PORT=5432

# Published host ports (override if conflicts)
REDIS_PORT=6379
OPA_PORT=8181
GATEWAY_PORT=8080
CONTROL_PLANE_PORT=8081
PORTAL_UI_PORT=5173
POLICY_LLM_PORT=11434

# HTTPS edge (Caddy): browser URL and portal Vite env at build time
EDGE_HOST=suez.acrosystemsinc.ai
EDGE_HTTPS_PORT=5443

# Optional: pinned Ollama model for policy-llm-init (see docker-compose.yml)
# POLICY_LLM_MODEL=qwen2.5-coder:1.5b

# Optional upstream keys for gateway (or use infra/secrets/* — see docs/local-development.md)
# OPENAI_COMPAT_API_KEY=
# GROQ_API_KEY=
