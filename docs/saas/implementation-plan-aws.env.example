# Suez on AWS – credentials and region
# Copy to repo root as .env and fill in values. Do not commit .env (.gitignore).
# chmod 600 .env

# Admin (IAM setup only: create user suez, group suezgateway, attach policies, create suez key)
ADMIN_ACCESS_KEY_ID=
ADMIN_SECRET_ACCESS_KEY=

# Suez (all deployment phases: CloudFormation, EKS, S3, etc.)
SUEZ_ACCESS_KEY_ID=
SUEZ_SECRET_ACCESS_KEY=

# Region (used for AWS CLI and stacks)
AWS_REGION=us-east-1

# Application domain (optional; used in implementation plan for suez.acrosystems.ai)
# DOMAIN=suez.acrosystems.ai
