# Context Guardian component rules (the root .gitignore covers node_modules/,
# dist/, .env*, key material and OS files).

# Tauri / Rust build output, including the .app bundle and DMG
src-tauri/target/
# Generated by the Tauri CLI at build time
src-tauri/gen/schemas/

# TypeScript incremental build state
*.tsbuildinfo

# Local-only test fixtures. Real checkpoints and prompts generated from them
# may contain private project details: keep them here, never in testdata/ or
# __fixtures__/ directly. Committed tests use synthetic fixtures only.
src-tauri/src/testdata/local/
src/guardian/__fixtures__/local/
