# AWS profile/region
AWS_PROFILE=suez
AWS_REGION=us-east-1

# Bootstrap stack (creates CloudFormation execution role)
BOOTSTRAP_STACK=suez-iam-bootstrap
BOOTSTRAP_TEMPLATE=scripts/suez-iam-bootstrap.yaml

# App stack (ALB + ECS/Fargate + RDS + Route53 + ACM)
APP_STACK=suez-app
APP_TEMPLATE=scripts/suez-saas-app-auto-cert.yaml

# Required inputs (network + image + DB)
VPC_ID=vpc-xxxxxxxx
PUBLIC_SUBNET_IDS=subnet-aaaaaaa,subnet-bbbbbbb
PRIVATE_SUBNET_IDS=subnet-ccccccc,subnet-ddddddd
CONTAINER_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/suez:latest
DB_PASSWORD=replace-me

# Domain/DNS (for ACM validation + Route53 alias)
DOMAIN_NAME=suez.acrosystemsinc.ai
HOSTED_ZONE_ID=Z123456ABCDEFG

# Optional sizing
DESIRED_COUNT=1
CPU=256
MEMORY=512
DB_USERNAME=suezapp
DB_NAME=suezdb

