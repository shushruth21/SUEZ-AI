{
	auto_https off
}

https://{$EDGE_HOST}:{$EDGE_HTTPS_PORT} {
	tls /certs/localhost-fullchain.pem /certs/localhost.key

	handle /control-plane/internal* {
		respond 404
	}

	handle /gateway/internal* {
		respond 404
	}

	handle_path /control-plane/* {
		reverse_proxy control-plane:8081
	}

	handle_path /gateway/* {
		reverse_proxy gateway:8080 {
			flush_interval -1
		}
	}

	# OPA and Ollama have no authentication: through the edge, anyone could
	# PUT /v1/policies and replace the authorization policy, or drive the
	# local model. Only the control plane and gateway talk to them, over the
	# internal network, so they are not routed here.
	handle /opa* {
		respond 404
	}

	handle /policy-llm* {
		respond 404
	}

	handle {
		reverse_proxy portal-ui:5173
	}
}
