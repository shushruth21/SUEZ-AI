# Production settings for infra/compose/docker-compose.prod.yml.
# Copy to .env.production (never commit it) and replace every value.
# Generate secrets with:  openssl rand -base64 32

COMPOSE_PROJECT_NAME=suez

# Public host name of the edge and the address for certificate issuance.
EDGE_HOST=suez.example.com
ACME_EMAIL=ops@example.com

# Browser origins allowed to call the APIs (comma separated, https only).
CORS_ALLOWED_ORIGINS=https://suez.example.com

# Shared secret between gateway and control plane (32+ characters).
SUEZ_INTERNAL_TOKEN=

# PostgreSQL. Use a managed database where possible (set POSTGRES_HOST and
# POSTGRES_SSLMODE=verify-full) and remove the postgres service.
POSTGRES_USER=suez
POSTGRES_PASSWORD=
POSTGRES_DB=suez
# POSTGRES_HOST=db.internal.example.com
# POSTGRES_SSLMODE=verify-full

# Redis password.
REDIS_PASSWORD=

# Identity. jwks = verify tokens from your identity provider; disabled = API keys only.
JWT_MODE=jwks
JWT_ISSUER=https://idp.example.com/
JWT_AUDIENCE=suez-api
# JWT_JWKS_URL=            # only if the issuer has no OpenID discovery document
# JWT_ALLOWED_ALGS=RS256,ES256
# JWT_TENANT_ID_CLAIM=tenant_id
# JWT_TENANT_SLUG_CLAIM=tenant_slug

# Files (outside the repository) holding secrets, one value per file.
SUEZ_DATA_KEY_PATH=/etc/suez/secrets/data_key
OPENAI_COMPAT_API_KEY_PATH=/etc/suez/secrets/openai_compat_api_key
GROQ_API_KEY_PATH=/etc/suez/secrets/groq_api_key
# Previous data keys kept readable during rotation (comma separated, base64).
# SUEZ_DATA_KEY_PREVIOUS=
